<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.likelion.bebc25.projectpatory.mapper.MemberMapper">

    <select id="findByEmail" parameterType="string" resultType="net.likelion.bebc25.projectpatory.domain.Member">
        SELECT id, email, nickname, password, profile_image, role, created_at
        FROM member
        WHERE email = #{email}
    </select>
</mapper>