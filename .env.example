# DB 컨테이너 초기화 설정 (MySQL 컨테이너용)
MYSQL_DATABASE=sns_db
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# DB 접속 정보 (Spring Boot 애플리케이션용)
DB_HOST=localhost
# 로컬 Windows MySQL이 3306을 쓰는 경우 Docker는 3307로 연결
DB_PORT=3307
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT
JWT_SECRET=

# PortOne (없으면 앱 기동 시 dummy 값 사용, 실제 결제 연동 시 필수)
PORTONE_STORE_ID=
PORTONE_API_SECRET=

# OAuth2 클라이언트 자격 증명
# 빈 문자열이면 기동 실패(Client id must not be empty). 미발급 시 dummy 유지
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
KAKAO_CLIENT_ID=dummy-kakao-client-id
KAKAO_CLIENT_SECRET=dummy-kakao-client-secret